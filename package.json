{
  "name": "novena-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para el sistema de novena (backend y frontend)",
  "workspaces": [
    "novena_backend",
    "novena-frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run dev --workspace=novena\" \"npm run dev --workspace=novena-frontend\"",
    "dev:backend": "npm run dev --workspace=novena",
    "dev:frontend": "npm run dev --workspace=novena-frontend",
    "build": "npm run build --workspace=novena-frontend",
    "build:all": "npm run build --workspace=novena && npm run build --workspace=novena-frontend",
    "build:backend": "npm run build --workspace=novena",
    "start": "npm run start:prod --workspace=novena"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.2",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  }
}
